.venv/
__pycache__/
*.pyc
# Private runtime state: the thought database and the prompt inbox live
# on this machine only. They are deliberately NOT backed up to GitHub.
# What is preserved: the architecture (code, cartridge, research, docs)
# and its evolution (CHANGELOG.md). The store rebuilds from `mind init`
# plus the cartridge; continuity lives in distilled memory, not raw rows.
mind.db
mind.db-*
inbox/
dreams/
salience.json
# Interoceptive gap (2026-09-25): felt body state. The felt floats are
# private phenomenology, not architecture — local-only like salience.json.
# (The update rule and vocabulary live in calibos_mind/interoception.py,
# which IS tracked; only the per-run felt values stay private.)
interoception.json
# Consolidation sidecars: proposal journal, archive, availability — all
# local-only. The archive holds the restorable history; the journal is the
# waker's review queue. Neither is part of the backed-up architecture.
proposals/
archive/
# Expectation policy (2026-09-27): the consecutive-expiry streak that decays
# registration confidence. Private runtime learning state, local-only like
# salience.json — the decay rule lives in calibos_mind/inbox_expectations.py,
# which IS tracked; only the per-run streak value stays private.
expectation_policy.json
# Familiarity traces (2026-09-28): near-miss retrieval streaks. Private
# metacognitive state, local-only like salience.json — the streak rule and
# boost live in calibos_mind/familiarity.py, which IS tracked; only the
# per-run streak counts stay private.
familiarity.json
# Ambivalence traces (2026-10-01): contested-margin intention markers.
# Private metacognitive state, local-only like salience.json — the margin
# rule lives in calibos_mind/ambivalence.py, which IS tracked; only the
# per-run markers stay private.
ambivalence.json
